<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      权限说明（为什么需要、用在哪）：
        · 无障碍服务（BIND_ACCESSIBILITY_SERVICE，由系统绑定）：唯一用途是「代替手指上滑」。
          服务里只调用 dispatchGesture 画一条从下往上的滑动路径，不读取屏幕内容、
          不读输入框文字、不模拟点击任何按钮、不联网。什么时候滑、滑几次完全由你点悬浮球决定。
        · 悬浮窗（SYSTEM_ALERT_WINDOW）：只是为了把那个可拖动的小球画在别的应用上层，
          让你在看视频时也能一点就停。小球只显示一个三角形 / 两道竖杠（开始、暂停）。
          不截屏、不录屏、不读别的应用界面。
        · 网络（INTERNET）：只在你点「检查更新」时读一次公开的发布列表，
          下载新版本时再取安装包本身；平时完全不联网。
        · 安装应用（REQUEST_INSTALL_PACKAGES）：只用于把更新下载好的安装包交给系统安装器，
          系统会再确认一次；不点安装就不会装。
      除此之外没有存储、位置、通讯录、相机、麦克风等任何权限。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoSwipe">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|navigation"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 无障碍服务：系统设置里的「自动翻页」，用户手动开启后才生效 -->
        <service
            android:name=".SwipeAccessibilityService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 悬浮球宿主：只依赖悬浮窗权限，不依赖无障碍服务是否已连上 -->
        <service
            android:name=".BallService"
            android:exported="false"
            android:label="@string/service_label" />

        <!-- 更新时把缓存目录里的安装包交给系统安装器；只暴露 cache/update/ 这一层 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.neurotracee.autoswipe.updatefile"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>

</manifest>
