<?xml version="1.0" encoding="utf-8"?>
<!--
  前景层：一支向上的手势箭头（对应「从下往上滑」），下方一道短横线当作起手位置。
  全部内容收在 108×108 画布中心的约 66×66 安全区内，圆形 / 方形 / 水滴形遮罩都不会裁掉。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 箭头竖笔 -->
    <path
        android:pathData="M54,74 L54,38"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round" />

    <!-- 箭头两撇 -->
    <path
        android:pathData="M41,51 L54,37.5 L67,51"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- 底部的起手短横：表示「从这里往上滑」 -->
    <path
        android:pathData="M44,82 L64,82"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:strokeAlpha="0.75" />
</vector>
